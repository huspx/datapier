{
  "useTabs": false,
  "indentWidth": 2,
  "newLineKind": "lf",
  "typescript": {
    "quoteStyle": "preferSingle"
  },
  "sql": {
    "dialect": "sqlite",
    "indentWidth": 4
  },
  "shfmt": {
    "dialect": "posix",
    "indentWidth": 4
  },
  "stylua": {
    "syntax": "luau",
    "indentWidth": 4
  },
  "includes": [
    "**/*.{html,css,json,jsonc,yml,yaml,toml,sql,sh,luau}"
  ],
  "excludes": [
    "**/node_modules",
    "**/target",
    "**/dist",
    "**/artifacts",
    "**/coverage",
    "**/.cache",
    "**/.datapier",
    "**/.codegraph",
    "**/vendor",
    "**/third_party",
    "**/generated",
    "**/tern.d.luau",
    "**/*-lock.json"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/sql@0.4.1",
    "npm:@dprint/shfmt@0.1.2",
    "npm:@dprint/stylua@0.1.0"
  ]
}
